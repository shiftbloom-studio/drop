// drop — Cloudflare Workers config.
// Before the first deploy, create the resources (see README → "Self-hosting") and
// replace the two <placeholders> below with the IDs Wrangler prints.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drop",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Serve on your own (sub)domain. The zone must be on the same Cloudflare account.
  // "routes": [{ "pattern": "drop.example.com", "custom_domain": true }],
  // "workers_dev": false,

  "vars": {
    "MAX_MULTIPART_MB": "95",
    "MAX_STREAM_MB": "500"
    // Optional: shows "Report this file" on item pages.
    // "ABUSE_EMAIL": "abuse@example.com",
    // Optional: operator details for /imprint, /impressum, /privacy and /datenschutz (hidden when unset).
    // Optional: token requests at /request (also set the TURNSTILE_SECRET secret, see README).
    // "TURNSTILE_SITE_KEY": "<your-turnstile-site-key>",
    // "LEGAL": "{\"name\":\"Jane Doe\",\"street\":\"Example St 1\",\"city\":\"12345 Town\",\"country\":{\"en\":\"Germany\",\"de\":\"Deutschland\"},\"email\":\"jane@example.com\",\"authority\":\"Your data protection authority, address\"}"
  },
  // Slow down token guessing, id enumeration and token request spam (per IP and minute). All optional.
  "ratelimits": [
    { "name": "AUTH_RL", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "MISS_RL", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } },
    { "name": "REQ_RL", "namespace_id": "1103", "simple": { "limit": 3, "period": 60 } }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "drop-files" }],
  "d1_databases": [{ "binding": "DB", "database_name": "drop-db", "database_id": "<your-d1-database-id>", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "LINKS", "id": "<your-kv-namespace-id>" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "drop-jobs" }],
    "consumers": [{ "queue": "drop-jobs", "max_batch_size": 5, "max_retries": 3 }]
  },
  // Optional: remove these two to run without thumbnails / AI alt text.
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "triggers": { "crons": ["17 * * * *"] }
  // Secret (not in this file): API_TOKEN → `npx wrangler secret put API_TOKEN`
}
