# drop on Node.js or Docker. Copy to .env and fill in. Never commit .env.
# (On Cloudflare Workers, use wrangler.jsonc vars and .dev.vars instead.)

# Required. Master token for uploads and the /api/* routes. Generate one with:
#   openssl rand -base64 32
API_TOKEN=change-me

# Public address, used for the links drop hands out. Set it whenever drop runs behind a proxy.
# PUBLIC_URL=https://drop.example.com

# Behind a reverse proxy: the header that carries the client IP (rate limits use it).
# One of x-forwarded-for, x-real-ip, cf-connecting-ip. Leave unset when clients connect directly,
# otherwise anyone can pick their own IP.
# TRUST_PROXY=x-forwarded-for

# Where files and the SQLite database live (Docker: the /data volume).
# DATA_DIR=./data
# PORT=8787
# HOST=0.0.0.0

# Upload limits in MB.
# MAX_MULTIPART_MB=95
# MAX_STREAM_MB=500

# Who runs this instance (footer and page metadata), and where your source code is (AGPL section 13).
# OPERATOR_NAME=Jane Doe
# OPERATOR_URL=https://example.com
# OPERATOR_PLACE=Berlin
# SOURCE_URL=https://github.com/you/drop

# Optional: "Report this file" on item pages.
# ABUSE_EMAIL=abuse@example.com

# Optional: imprint and privacy policy at /imprint, /impressum, /privacy, /datenschutz.
# LEGAL={"name":"Jane Doe","street":"Example St 1","city":"12345 Town","country":{"en":"Germany","de":"Deutschland"},"email":"jane@example.com","authority":"Your data protection authority, address"}

# Optional: abuse.ch MalwareBazaar Auth-Key (free at https://auth.abuse.ch/). Known malware goes on hold.
# MB_AUTH_KEY=

# Optional: token requests at /request, checked with Cloudflare Turnstile (works without hosting on Cloudflare).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Optional: uploads without a token from the start page (needs both Turnstile keys). Items expire after 12 hours at most.
# PUBLIC_UPLOADS=on
# PUBLIC_MAX_MB=25
# PUBLIC_PASTE_KB=512
# PUBLIC_DAILY_UPLOADS=30
# PUBLIC_DAILY_MB=200
